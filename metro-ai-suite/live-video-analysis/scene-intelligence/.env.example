# Docker image and compose configuration
PROJECT_NAME=scene-intelligence
TAG=latest

# Service ports
PORT=9100
RTSP_SERVER_PORT=8554
WHEP_SERVER_PORT=8889
METRICS_SERVICE_PORT=9090
OVMS_REST_PORT=8000

# Logging
LOG_LEVEL=INFO

# Host user/group mapping for services that write into mounted volumes.
# setup_env.sh auto-detects these and writes them into .env.
HOST_UID=1000
HOST_GID=1000

# Video source
# WebRTC
# Run `bash scripts/setup_env.sh` to detect the host LAN IP and fill these.
HOST_IP=127.0.0.1
WEBRTC_SIGNALING_PORT=8889
WEBRTC_SIGNALING_URL=http://127.0.0.1:8889
WEBRTC_RELAY_URL=rtsp://mediamtx:8554
WEBRTC_AUTO_PUBLISH=true
TURN_USERNAME=scene
TURN_PASSWORD=scenepass

# VLM inference (OpenVINO GenAI)
VLM_ENABLED=true
VLM_INTERVAL=2.0
VLM_MAX_TOKENS=100
# Optional input resize before VLM inference; keep empty to use original frame size.
# Format: WIDTHxHEIGHT (example: 640x360)
VLM_FRAME_RESIZE=

# Host `render` group id to allow /dev/dri access inside the container.
# setup_env.sh auto-detects this and writes it into .env.
RENDER_GROUP_ID=992

# OVMS VLM server
OVMS_SOURCE_MODEL=OpenVINO/InternVL2-1B-int4-ov
OVMS_TARGET_DEVICE=GPU

# Optional runtime tuning
RTSP_TIMEOUT=15.0
MAX_STREAMS=8
METRICS_POLL_INTERVAL_MS=1000

# Model download helper
OVMS_RELEASE_TAG=v2026.1.0
MODEL_DOWNLOAD_IMAGE_TAG=latest
HUGGINGFACEHUB_API_TOKEN=
MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_URL=https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/main/microservices/model-download/scripts/get_model.sh
