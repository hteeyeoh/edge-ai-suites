# Docker image and compose configuration
PROJECT_NAME=scene-intelligence
TAG=latest

# Service ports
PORT=9100
RTSP_SERVER_PORT=8554
WHEP_SERVER_PORT=8889
METRICS_SERVICE_PORT=9090

# Logging
LOG_LEVEL=INFO

# Video source
# WebRTC
# Run `bash scripts/setup_env.sh` to detect the host LAN IP and fill these.
HOST_IP=127.0.0.1
WEBRTC_SIGNALING_PORT=8889
WEBRTC_SIGNALING_URL=http://127.0.0.1:8889
WEBRTC_RELAY_URL=rtsp://mediamtx:8554
WEBRTC_AUTO_PUBLISH=true
TURN_USERNAME=scene
TURN_PASSWORD=scenepass

# VLM inference (OpenVINO GenAI)
VLM_ENABLED=true
VLM_MODEL=InternVL2-1B
VLM_DEVICE=CPU
VLM_INTERVAL=2.0
VLM_MAX_TOKENS=100
# Optional input resize before VLM inference; keep empty to use original frame size.
# Format: WIDTHxHEIGHT (example: 640x360)
VLM_FRAME_RESIZE=

# Host `render` group id to allow /dev/dri access inside the container.
# setup_env.sh auto-detects this and writes it into .env.
RENDER_GROUP_ID=992

# Optional runtime tuning
RTSP_TIMEOUT=15.0
MAX_STREAMS=8
METRICS_POLL_INTERVAL_MS=1000

# Testing limits: cap segments written / VLM inferences per stream so a
# looping test RTSP source doesn't run (and write to disk) indefinitely.
# 0 = unlimited.
MAX_SEGMENTS=20
VLM_MAX_INFERENCES=20

# Model download helper
OVMS_RELEASE_TAG=v2026.1.0
MODEL_DOWNLOAD_IMAGE_TAG=latest
HUGGINGFACEHUB_API_TOKEN=
MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_URL=https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/main/microservices/model-download/scripts/get_model.sh
# Segment writer + frame metadata registry (deep-analysis handoff)
SEGMENT_OUTPUT_DIR=segments
SEGMENT_TIME_SECONDS=15
FRAME_SAMPLE_FPS=1
FRAME_REGISTRY_MAX_RECORDS=3000

# Segment cleanup: reclaim rotated-out segments once they're no longer
# needed. Alert streams reclaim based on VLM verdict (Yes/No); streams
# without an alert_event fall back to SEGMENT_TTL_SECONDS. The most recent
# SEGMENT_RETENTION_GRACE segments are always kept; SEGMENT_MAX_ON_DISK is a
# hard cap regardless of verdict/TTL. 0 disables TTL or the disk cap.
SEGMENT_RETENTION_GRACE=2
SEGMENT_TTL_SECONDS=300.0
SEGMENT_MAX_ON_DISK=50
# Host disk directory bind-mounted into the container at /app/segments.
# Defaults to ./segments (real disk I/O, not tmpfs) so segments persist.
HOST_SEGMENTS_DIR=./segments
