# Docker image and compose configuration
PROJECT_NAME=scene-intelligence
TAG=latest

# Service ports
PORT=9100
RTSP_SERVER_PORT=8554
WHEP_SERVER_PORT=8889
METRICS_SERVICE_PORT=9090

# Logging
LOG_LEVEL=INFO

# Video source
# WebRTC
# Run `bash scripts/setup_env.sh` to detect the host LAN IP and fill these.
HOST_IP=127.0.0.1
WEBRTC_SIGNALING_PORT=8889
WEBRTC_SIGNALING_URL=http://127.0.0.1:8889
WEBRTC_RELAY_URL=rtsp://mediamtx:8554
WEBRTC_AUTO_PUBLISH=true
TURN_USERNAME=scene
TURN_PASSWORD=scenepass

# VLM inference (OpenVINO GenAI)
VLM_ENABLED=true
VLM_MODEL=Qwen3.5-0.8B-int4-ov
VLM_DEVICE=CPU
VLM_INTERVAL=2.0
VLM_MAX_TOKENS=100
# Optional input resize before VLM inference; keep empty to use original frame size.
# Independent of SEGMENT_DIM_* below (applied on top of the segment encode size).
# Format: WIDTHxHEIGHT (example: 640x360)
VLM_FRAME_RESIZE=

# Benchmarked segment recording (encode) dimensions per source aspect ratio;
# the closest bucket to the source's aspect ratio is used. This only affects
# the .mp4 encode resolution, not VLM input size. Format: WIDTHxHEIGHT.
SEGMENT_DIM_1_1=448x448
SEGMENT_DIM_4_3=512x384
SEGMENT_DIM_16_9=576x320

# Deep analyzer: multi-frame follow-up model run on a segment once a sampled
# frame in it gets a "Yes" alert verdict from the VLM above. Independent
# pipeline/device — model tree layout mirrors VLM_MODEL (<root>/<device>/<model>).
DEEP_ANALYZER_ENABLED=true
DEEP_ANALYZER_MODEL=Qwen3.5-2B-int4-ov
DEEP_ANALYZER_DEVICE=GPU
DEEP_ANALYZER_MAX_FRAMES=8
DEEP_ANALYZER_MAX_TOKENS=128
DEEP_ANALYZER_DEDUP_CACHE_SIZE=500

# Host `render` group id to allow /dev/dri access inside the container.
# setup_env.sh auto-detects this and writes it into .env.
RENDER_GROUP_ID=992

# Optional runtime tuning
RTSP_TIMEOUT=15.0
MAX_STREAMS=8
METRICS_POLL_INTERVAL_MS=1000

# Testing limits: cap segments written / VLM inferences per stream so a
# looping test RTSP source doesn't run (and write to disk) indefinitely.
# 0 = unlimited. Only for debugging. Need to remove.
MAX_SEGMENTS=3
VLM_MAX_INFERENCES=20

# Model download helper
OVMS_RELEASE_TAG=v2026.1.0
MODEL_DOWNLOAD_IMAGE_TAG=latest
HUGGINGFACEHUB_API_TOKEN=
MODEL_DOWNLOAD_EPHEMERAL_SCRIPT_URL=https://raw.githubusercontent.com/open-edge-platform/edge-ai-libraries/main/microservices/model-download/scripts/get_model.sh
# Segment writer + frame metadata registry (deep-analysis handoff)
SEGMENT_OUTPUT_DIR=segments
SEGMENT_TIME_SECONDS=15
FRAME_SAMPLE_FPS=1
FRAME_REGISTRY_MAX_RECORDS_PER_STREAM=500

# Hard cap on finalized segments retained on disk per stream; oldest is
# deleted once a new segment finalizes and pushes the count over this.
# 0 disables the cap.
SEGMENT_MAX_ON_DISK=50

# Host directory bind-mounted into the container at /app/segments. Points at
# tmpfs-backed shared memory (in-memory, not persisted) so segments don't
# survive a host reboot but avoid real disk I/O; setup_env.sh creates this
# path automatically. Use a real disk path instead if persistence is needed.
HOST_SEGMENTS_DIR=/dev/shm/scene-intelligence-segments
